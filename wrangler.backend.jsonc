{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vertflux-drop-api",
  "main": "backend/index.mjs",
  "account_id": "bf8566234d0f57c2451986e3cdcb01c4",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": false }, "traces": { "enabled": false } },
  "durable_objects": { "bindings": [
    { "name": "ROOMS", "class_name": "DropRoom" },
    { "name": "DIRECTORY", "class_name": "DropDirectory" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DropRoom", "DropDirectory"] }]
}
